	<variable name="CCF0_REGION_NAME" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({APPLICATION_RPT.ORG_UNIT_NO} = 1833) then
//'RNI - Northern Interior'
//else
//if ({APPLICATION_RPT.ORG_UNIT_NO} = 1834) then
//'RSI - Southern Interior'
//else
//if ({APPLICATION_RPT.ORG_UNIT_NO} = 1835) then
//'RCO - Costal Forest'

( $F{ORG_UNIT_NO} == null ? "" :
( $F{ORG_UNIT_NO}.intValue() == 1833 ? "RNI - Northern Interior" :
( $F{ORG_UNIT_NO}.intValue() == 1834 ? "RSI - Southern Interior" :
( $F{ORG_UNIT_NO}.intValue() == 1835 ? "RCO - Costal Forest" :
( $F{ORG_UNIT_NO}.intValue() == 1903 ? "RCB - Cariboo Region" :
( $F{ORG_UNIT_NO}.intValue() == 1904 ? "RKB - Kootenay-Boundary Region" :
( $F{ORG_UNIT_NO}.intValue() == 1905 ? "RNO - Northeast Region" :
( $F{ORG_UNIT_NO}.intValue() == 1906 ? "ROM - Omineca Region" :
( $F{ORG_UNIT_NO}.intValue() == 1907 ? "RTO - Thompson-Okanagan Region" :
( $F{ORG_UNIT_NO}.intValue() == 1908 ? "RSK - Skeena Region" :
( $F{ORG_UNIT_NO}.intValue() == 1909 ? "RSC - South Coast Region" :
( $F{ORG_UNIT_NO}.intValue() == 1910 ? "RWC - West Coast Region" : ""
))))))))))))]]></variableExpression>
	</variable>
	<variable name="CCF1_EXEMPTION_REASON" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({APPLICATION_RPT.EXPORT_EXEMPTION_REASON_CODE} = 'U') then
//'Utilization'
//else
//if ({APPLICATION_RPT.EXPORT_EXEMPTION_REASON_CODE} = 'S') then
//'Surplus'
//else
//if ({APPLICATION_RPT.EXPORT_EXEMPTION_REASON_CODE} = 'E') then
//'Economic'
//else
//'All'

$F{EXPORT_EXEMPTION_REASON_CODE}==null || $F{EXPORT_EXEMPTION_REASON_CODE}.isEmpty()
?   "All"
:   $F{EXPORT_EXEMPTION_REASON_CODE}.equalsIgnoreCase( "U" )
    ?   "Utilization"
    :   $F{EXPORT_EXEMPTION_REASON_CODE}.equalsIgnoreCase( "S" )
        ?   "Surplus"
        :   $F{EXPORT_EXEMPTION_REASON_CODE}.equalsIgnoreCase( "E" )
            ?   "Economic"
            :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF2_GROWTH_TYPE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({APPLICATION_RPT.EXPORT_GROWTH_TYPE_CODE} = 'O') then
//'Old'
//else
//if ({APPLICATION_RPT.EXPORT_GROWTH_TYPE_CODE} = 'S') then
//'Second'
//else
//'All'

$F{EXPORT_GROWTH_TYPE_CODE}==null || $F{EXPORT_GROWTH_TYPE_CODE}.isEmpty()
?   "All"
:   $F{EXPORT_GROWTH_TYPE_CODE}.equalsIgnoreCase( "O" )
    ?   "Old"
    :   $F{EXPORT_GROWTH_TYPE_CODE}.equalsIgnoreCase( "S" )
        ?   "Second"
        :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF3_SUMMARY_REGION" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?P_ORG_UNIT} = 0) then
//'All'
//else if ({?P_ORG_UNIT} = 1833) then
//'Northern Interior Forest Region'
//else if ({?P_ORG_UNIT} = 1834) then
//'Southern Interior Forest Region'
//else if ({?P_ORG_UNIT} = 1835) then
//'Coast Forest Region'

( $P{P_ORG_UNIT} == null || $P{P_ORG_UNIT}.isEmpty() || $P{P_ORG_UNIT}.equalsIgnoreCase( "0" ) ? "All" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1833" ) ? "Northern Interior Forest Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1834" ) ? "Southern Interior Forest Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1835" ) ? "Coast Forest Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1903" ) ? "Cariboo Natural Resource Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1904" ) ? "Kootenay-Boundary Natural Resource Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1905" ) ? "Northeast Natural Resource Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1906" ) ? "Omineca Natural Resource Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1907" ) ? "Thompson-Okanagan Natural Resource Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1908" ) ? "Skeena Natural Resource Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1909" ) ? "South Coast Natural Resource Region" :
( $P{P_ORG_UNIT}.equalsIgnoreCase( "1910" ) ? "West Coast Natural Resource Region" : ""
))))))))))))]]></variableExpression>
	</variable>
	<variable name="CCF4_SUMMARY_REASON" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (isnull({?P_EXEMPTION_REASON})) then
//'All'
//else if ({?P_EXEMPTION_REASON} = 'S') then
//'Surplus'
//else if ({?P_EXEMPTION_REASON} = 'E') then
//'Economic'
//else if ({?P_EXEMPTION_REASON} = 'U') then
//'Utilization'
//else
//'All'

$P{P_EXEMPTION_REASON} == null || $P{P_EXEMPTION_REASON}.isEmpty()
?   "All"
:   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "S" )
    ?   "Surplus"
    :   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "E" )
        ?   "Economic"
        :   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "U" )
            ?   "Utilization"
            :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF5_SUMMARY_JURISDICTION" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (isnull({?P_JURISDICTION})) then
//'All'
//else if ({?P_JURISDICTION} = 'P') then
//'Provincial'
//else if ({?P_JURISDICTION} = 'F') then
//'Federal'
//else
//'All'

$P{P_JURISDICTION}==null || $P{P_JURISDICTION}.isEmpty()
?   "All"
:   $P{P_JURISDICTION}.equalsIgnoreCase( "P" )
    ?   "Provincial"
    :   $P{P_JURISDICTION}.equalsIgnoreCase( "F" )
        ?   "Federal"
        :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF6_SUMMARY_GROWTH" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (isnull({?P_GROWTH_TYPE})) then
//'All'
//else if ({?P_GROWTH_TYPE} = 'O') then
//'Old'
//else if ({?P_GROWTH_TYPE} = 'S') then
//'Second'
//else
//'All'

$P{P_GROWTH_TYPE} == null || $P{P_GROWTH_TYPE}.isEmpty()
?   "All"
:   $P{P_GROWTH_TYPE}.equalsIgnoreCase( "O" )
    ?   "Old"
    :   $P{P_GROWTH_TYPE}.equalsIgnoreCase( "S" )
        ?   "Second"
        :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF7_TITLE_DATE_RANGE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (
//    (isnull({?P_RECEIVED_FROM}) or {?P_RECEIVED_FROM} = '') and
//    (isnull({?P_RECEIVED_TO}) or {?P_RECEIVED_TO} = '')
//    ) then
//'All Dates'
//else if (
//    isnull({?P_RECEIVED_FROM}) or {?P_RECEIVED_FROM} = ''
//    ) then
//{?P_RECEIVED_TO} + ' and Previous'
//else if (
//    isnull({?P_RECEIVED_TO}) or {?P_RECEIVED_TO} = ''
//    ) then
//{?P_RECEIVED_FROM} + ' and After'
//else
//{?P_RECEIVED_FROM} + ' to ' + {?P_RECEIVED_TO}

($P{P_RECEIVED_FROM} == null || $P{P_RECEIVED_FROM}.isEmpty()) &&
($P{P_RECEIVED_TO} == null || $P{P_RECEIVED_TO}.isEmpty())
?   "All Dates"
:   $P{P_RECEIVED_FROM} == null || $P{P_RECEIVED_FROM}.isEmpty()
    ?   $P{P_RECEIVED_TO} + " and Previous"
    :   $P{P_RECEIVED_TO} == null || $P{P_RECEIVED_TO}.isEmpty()
        ?   $P{P_RECEIVED_FROM} + " and After"
        :   $P{P_RECEIVED_FROM} + " to " + $P{P_RECEIVED_TO}]]></variableExpression>
	</variable>
	<variable name="CCF8_F_CLIENT" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_CLIENT_NUMBER}) or {?P_CLIENT_NUMBER} = '' then
//    'All'
//else
//    {?P_CLIENT_NUMBER}

$P{P_CLIENT_NUMBER} == null || $P{P_CLIENT_NUMBER}.isEmpty()
?   "All"
:   $P{P_CLIENT_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF9_F_DATE_FROM" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_RECEIVED_FROM}) or {?P_RECEIVED_FROM} = '' then
//    'Not Entered'
