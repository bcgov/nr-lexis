:   $P{P_RECEIVED_TO}]]></variableExpression>
	</variable>
	<variable name="CCF11_F_APPLICATION_NUMBER" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({APPLICATION_RPT.EXPORT_JURISDICTION_CODE} = "F") Then
//    {APPLICATION_RPT.EXPORT_JURISDICTION_CODE} + ToText({APPLICATION_RPT.FED_APPLICATION_NUMBER}, 0, "")
//else if ({APPLICATION_RPT.EXPORT_JURISDICTION_CODE} = "P") Then
//    {APPLICATION_RPT.EXPORT_JURISDICTION_CODE} + ToText({APPLICATION_RPT.APPLICATION_NUMBER}, 0, "")
//else
//""

$F{EXPORT_JURISDICTION_CODE} !=null && $F{EXPORT_JURISDICTION_CODE}.equalsIgnoreCase( "F" )
?   $F{EXPORT_JURISDICTION_CODE} + ( $F{FED_APPLICATION_NUMBER} == null ? "" : new DecimalFormat("###0").format( $F{FED_APPLICATION_NUMBER} ) )
:   $F{EXPORT_JURISDICTION_CODE}!=null && $F{EXPORT_JURISDICTION_CODE}.equalsIgnoreCase( "P" )
    ?   $F{EXPORT_JURISDICTION_CODE} + ( $F{APPLICATION_NUMBER} == null ? "" : new DecimalFormat("###0").format( $F{APPLICATION_NUMBER} ) )
    :   ""]]></variableExpression>
	</variable>
