	</variable>
	<variable name="CCF10_F_DATE_TO" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_RECEIVED_TO}) or {?P_RECEIVED_TO} = '' then
//    'Not Entered'
//else
