?   "Not Entered"
:   $P{P_APPLICATION_DATE_FROM}]]></variableExpression>
	</variable>
	<variable name="CCF2_REGION" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//GetRegionName ({?P_ORG_UNIT})
//Function (StringVar P_ORG_UNIT)
//Local StringVar org_unit_name := "";
//Local NumberVar counter := 0;
//if (P_ORG_UNIT LIKE "*1903*") then ( org_unit_name := org_unit_name & ", RCB";
//    counter := counter + 1; );
//if (P_ORG_UNIT LIKE "*1904*") then(     org_unit_name := org_unit_name & ", RKB";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1905*") then(    org_unit_name := org_unit_name & ", RNO";
//    counter := counter + 1; );
//if (P_ORG_UNIT LIKE "*1906*") then(    org_unit_name := org_unit_name & ", ROM";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1907*") then(    org_unit_name := org_unit_name & ", RTO";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1908*") then(    org_unit_name := org_unit_name & ", RSK";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1909*") then(    org_unit_name := org_unit_name & ", RSC";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1910*") then(    org_unit_name := org_unit_name & ", RWC";
//    counter := counter + 1;);
//if Len(org_unit_name) > 0 then
//(  if counter = 8 then
//        "All"
//  else
//      Right(org_unit_name, len(org_unit_name) - 2)
//)else
//    org_unit_name;

$P{P_ORG_UNIT} == null ? "" :
$P{P_ORG_UNIT}!=null &&
$P{P_ORG_UNIT}.contains( "1903" )&& $P{P_ORG_UNIT}.contains( "1904" ) && $P{P_ORG_UNIT}.contains( "1905" ) && $P{P_ORG_UNIT}.contains( "1906" ) &&
$P{P_ORG_UNIT}.contains( "1907" )&& $P{P_ORG_UNIT}.contains( "1908" ) && $P{P_ORG_UNIT}.contains( "1909" ) && $P{P_ORG_UNIT}.contains( "1910" )
?   "All"
:   org.apache.commons.lang.StringUtils.chomp(
        (
            ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1903" ) ? "RCB, " : "" ) +
            ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1904" ) ? "RKB, " : "" ) +
            ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1905" ) ? "RNO, " : "" ) +
            ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1906" ) ? "ROM, " : "" ) +
            ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1907" ) ? "RTO, " : "" ) +
            ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1908" ) ? "RSK, " : "" ) +
            ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1909" ) ? "RSC, " : "" ) +
            ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1910" ) ? "RWC, " : "" )
        ), ", "
    )]]></variableExpression>
	</variable>
	<variable name="CCF3_CLIENT" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ISNULL({?P_CLIENT_NUMBER}) OR {?P_CLIENT_NUMBER} = '' OR {?P_CLIENT_NUMBER} = 'DUMMY' THEN
//'All'
//ELSE
//IF ISNULL({OFFERS_LEDGER_RPT.CLIENT_TYPE_CODE}) THEN
//    "Unknown Client"
//ELSE IF {OFFERS_LEDGER_RPT.CLIENT_TYPE_CODE} = "I" THEN
//    {?P_CLIENT_NUMBER} + ' - ' + {OFFERS_LEDGER_RPT.CLIENT_NAME} + ', ' + {OFFERS_LEDGER_RPT.LEGAL_FIRST_NAME} + ' ' + {OFFERS_LEDGER_RPT.LEGAL_MIDDLE_NAME}
//ELSE
//    {?P_CLIENT_NUMBER} + ' - ' + {OFFERS_LEDGER_RPT.CLIENT_NAME}


$P{P_CLIENT_NUMBER}==null || $P{P_CLIENT_NUMBER}.isEmpty() || $P{P_CLIENT_NUMBER}.equalsIgnoreCase( "DUMMY" )
?   "All"
:   $F{CLIENT_TYPE_CODE}==null
    ?   "Unknown Client"
    :   $F{CLIENT_TYPE_CODE}.equalsIgnoreCase( "I" )
        ?   $P{P_CLIENT_NUMBER} + " - " + ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} ) + ", " + ( $F{LEGAL_FIRST_NAME} == null || $F{LEGAL_FIRST_NAME}.isEmpty() ? "" : $F{LEGAL_FIRST_NAME} + " " ) + ( $F{LEGAL_MIDDLE_NAME} == null || $F{LEGAL_MIDDLE_NAME}.isEmpty() ? "" : $F{LEGAL_MIDDLE_NAME} )
        :   $P{P_CLIENT_NUMBER} + " - " + ( $F{CLIENT_NAME} == null || $F{CLIENT_NAME}.isEmpty() ? "" : $F{CLIENT_NAME} )]]></variableExpression>
	</variable>
	<variable name="CCF4_WITHDRAWN_IND" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ISNULL({OFFERS_LEDGER_RPT.OFFER_WITHDRAWAL_DATE}) THEN
//    "N"
//ELSE
//    "Y"

$F{OFFER_WITHDRAWAL_DATE}==null
?   "N"
:   "Y"]]></variableExpression>
	</variable>
	<variable name="CCF5_F_JURISDICTION" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_JURISDICTION}) or {?P_JURISDICTION} = '' then
//    'All'
//else if {?P_JURISDICTION} = 'P' then
//    'Provincial'
//else if {?P_JURISDICTION} = 'F' then
//    'Federal'
//else if {?P_JURISDICTION} = 'I' then
//    'Indian Reserve'

$P{P_JURISDICTION} == null || $P{P_JURISDICTION}.isEmpty()
?   "All"
:   $P{P_JURISDICTION}.equalsIgnoreCase( "P" )
    ?   "Provincial"
    :   $P{P_JURISDICTION}.equalsIgnoreCase( "F" )
        ?   "Federal"
        :   $P{P_JURISDICTION}.equalsIgnoreCase( "I" )
            ? "Indian Reserve"
            : ""]]></variableExpression>
	</variable>
	<variable name="CCF6_F_DATE_RANGE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (
//    (isnull({?P_APPLICATION_DATE_FROM}) or {?P_APPLICATION_DATE_FROM} = '') and
//    (isnull({?P_APPLICATION_DATE_TO}) or {?P_APPLICATION_DATE_TO} = '')
//    ) then
//'All Dates'
//else if (
//    isnull({?P_APPLICATION_DATE_FROM}) or {?P_APPLICATION_DATE_FROM} = ''
//    ) then
//{?P_APPLICATION_DATE_TO} + ' and Previous'
//else if (
//    isnull({?P_APPLICATION_DATE_TO}) or {?P_APPLICATION_DATE_TO} = '') then
//{?P_APPLICATION_DATE_FROM} + ' and After'
//else
//{?P_APPLICATION_DATE_FROM} + ' to ' + {?P_APPLICATION_DATE_TO}

($P{P_APPLICATION_DATE_FROM}== null || $P{P_APPLICATION_DATE_FROM}.isEmpty()) &&
($P{P_APPLICATION_DATE_TO} == null ||$P{P_APPLICATION_DATE_TO}.isEmpty())
?   "All Dates"
:   $P{P_APPLICATION_DATE_FROM}== null || $P{P_APPLICATION_DATE_FROM}.isEmpty()
    ?   $P{P_APPLICATION_DATE_TO} + " and Previous"
    :   $P{P_APPLICATION_DATE_TO} == null ||$P{P_APPLICATION_DATE_TO}.isEmpty()
        ?   $P{P_APPLICATION_DATE_FROM} + " and After"
        :   $P{P_APPLICATION_DATE_FROM} + " to " + $P{P_APPLICATION_DATE_TO}]]></variableExpression>
	</variable>
	<variable name="CCF7_F_APPLICATION_NUMBER" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({OFFERS_LEDGER_RPT.EXPORT_JURISDICTION_CODE} = "F") Then
//    {OFFERS_LEDGER_RPT.EXPORT_JURISDICTION_CODE} + ToText({OFFERS_LEDGER_RPT.FED_APPLICATION_NUMBER}, 0, "")
//else if ({OFFERS_LEDGER_RPT.EXPORT_JURISDICTION_CODE} = "P") Then
//    {OFFERS_LEDGER_RPT.EXPORT_JURISDICTION_CODE} + ToText({OFFERS_LEDGER_RPT.APPLICATION_NUMBER}, 0, "")
//else
//""

$F{EXPORT_JURISDICTION_CODE}!=null && $F{EXPORT_JURISDICTION_CODE}.equalsIgnoreCase( "F" )
?   $F{EXPORT_JURISDICTION_CODE} + ( $F{FED_APPLICATION_NUMBER} == null ? "" : new DecimalFormat("###0").format( $F{FED_APPLICATION_NUMBER} ) )
:   $F{EXPORT_JURISDICTION_CODE}!=null && $F{EXPORT_JURISDICTION_CODE}.equalsIgnoreCase( "P" )
    ?   $F{EXPORT_JURISDICTION_CODE} + ( $F{APPLICATION_NUMBER} == null ? "" : new DecimalFormat("###0").format( $F{APPLICATION_NUMBER} ) )
    :   ""]]></variableExpression>
	</variable>
	<variable name="CCF8_WITHDRAWN_FROM_DATE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_WITHDRAWN_DATE_FROM}) or {?P_WITHDRAWN_DATE_FROM} = '' then
//    'Not Entered'
//else
//    {?P_WITHDRAWN_DATE_FROM}

$P{P_WITHDRAWN_DATE_FROM}==null || $P{P_WITHDRAWN_DATE_FROM}.isEmpty()
?   "Not Entered"
:   $P{P_WITHDRAWN_DATE_FROM}]]></variableExpression>
	</variable>
	<variable name="CCF9_WITHDRAWN_TO_DATE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_WITHDRAWN_DATE_TO}) or {?P_WITHDRAWN_DATE_TO} = '' then
//    'Not Entered'
//else
//    {?P_WITHDRAWN_DATE_TO}

$P{P_WITHDRAWN_DATE_TO}== null || $P{P_WITHDRAWN_DATE_TO}.isEmpty()
?   "Not Entered"
:   $P{P_WITHDRAWN_DATE_TO}]]></variableExpression>
	</variable>
