	<variable name="CCF0_TO_DATE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_APPLICATION_DATE_TO}) or {?P_APPLICATION_DATE_TO} = '' then
//    'Not Entered'
