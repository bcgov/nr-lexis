				<subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "LEXIS_HEADER" + $P{SUBREPORT_EXT}]]></subreportExpression>
			</subreport>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="bb76374e-cda3-4284-8a40-7c82eb9e6641" x="180" y="15" width="324" height="71" forecolor="#000000"/>
				<textElement textAlignment="Center">
					<font fontName="Arial" size="12" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Province of British Columbia" + System.getProperty("line.separator") + "Log Exemption Information System" + System.getProperty("line.separator") + "Offers Ledger" + System.getProperty("line.separator") + $V{CCF6_F_DATE_RANGE}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="483402ea-3671-43f3-a3d1-c82be3fa7d5c" x="4" y="81" width="501" height="11" forecolor="#000000"/>
				<textElement textAlignment="Left">
					<font fontName="Arial" size="8" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Region			: " + ( $F{ORG_UNIT_CODE} == null || $F{ORG_UNIT_CODE}.isEmpty() ? "" : $F{ORG_UNIT_CODE} + " - " ) + ( $F{ORG_UNIT_NAME} == null || $F{ORG_UNIT_NAME}.isEmpty() ? "" : $F{ORG_UNIT_NAME} )]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true" isBlankWhenNull="true">
				<reportElement uuid="adc22aa6-732f-44cd-a2df-cb6bc99d7def" x="4" y="92" width="501" height="10" forecolor="#000000"/>
				<textElement textAlignment="Left">
