	</variable>
	<variable name="CCF1_FROM_DATE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_APPLICATION_DATE_FROM}) or {?P_APPLICATION_DATE_FROM} = '' then
//    'Not Entered'
//else
