	<variable name="CCF5_F_REGION" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//GetRegionName({?P_ORG_UNIT_NUMBER})
//Function (StringVar P_ORG_UNIT)
//Local StringVar org_unit_name := "";
//Local NumberVar counter := 0;
//if (P_ORG_UNIT LIKE "*1903*") then ( org_unit_name := org_unit_name & ", RCB";
//    counter := counter + 1; );
//if (P_ORG_UNIT LIKE "*1904*") then(     org_unit_name := org_unit_name & ", RKB";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1905*") then(    org_unit_name := org_unit_name & ", RNO";
//    counter := counter + 1; );
//if (P_ORG_UNIT LIKE "*1906*") then(    org_unit_name := org_unit_name & ", ROM";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1907*") then(    org_unit_name := org_unit_name & ", RTO";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1908*") then(    org_unit_name := org_unit_name & ", RSK";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1909*") then(    org_unit_name := org_unit_name & ", RSC";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1910*") then(    org_unit_name := org_unit_name & ", RWC";
//    counter := counter + 1;);
//if Len(org_unit_name) > 0 then
//(  if counter = 8 then
//        "All"
//  else
//      Right(org_unit_name, len(org_unit_name) - 2)
//)else
//    org_unit_name;

$P{P_ORG_UNIT_NUMBER} == null ? "" :
$P{P_ORG_UNIT_NUMBER}!=null &&
$P{P_ORG_UNIT_NUMBER}.contains( "1903" )&& $P{P_ORG_UNIT_NUMBER}.contains( "1904" ) && $P{P_ORG_UNIT_NUMBER}.contains( "1905" ) && $P{P_ORG_UNIT_NUMBER}.contains( "1906" ) &&
$P{P_ORG_UNIT_NUMBER}.contains( "1907" )&& $P{P_ORG_UNIT_NUMBER}.contains( "1908" ) && $P{P_ORG_UNIT_NUMBER}.contains( "1909" ) && $P{P_ORG_UNIT_NUMBER}.contains( "1910" )
?   "All"
:   ca.bc.gov.mof.lexis.service.report.LexisReportStringUtils.chomp(
        (
            ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1903" ) ? "RCB, " : "" ) +
            ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1904" ) ? "RKB, " : "" ) +
            ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1905" ) ? "RNO, " : "" ) +
            ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1906" ) ? "ROM, " : "" ) +
            ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1907" ) ? "RTO, " : "" ) +
            ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1908" ) ? "RSK, " : "" ) +
            ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1909" ) ? "RSC, " : "" ) +
            ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1910" ) ? "RWC, " : "" )
        ), ", "
    )]]></variableExpression>
	</variable>
	<variable name="CCF6_F_EXEMPT_TYPE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?P_EXEMPTION_TYPE} = 'M') then
//'Ministerial'
//else if ({?P_EXEMPTION_TYPE} = 'O') then
//'OIC'
//else if ({?P_EXEMPTION_TYPE} = 'F') then
//'Federal'
//else
//'All'

$P{P_EXEMPTION_TYPE}== null || $P{P_EXEMPTION_TYPE}.isEmpty()
?   "All"
:   $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "M" )
    ?   "Ministerial"
    :   $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "O" )
        ?   "OIC"
        :   $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "F" )
            ?   "Federal"
            :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF7_F_EXEMPT_REASON" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?P_EXEMPTION_REASON} = 'S') then
