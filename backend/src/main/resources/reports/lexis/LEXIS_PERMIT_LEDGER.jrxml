//'Economic'
//else
//'All'

$P{P_EXEMPTION_REASON} == null || $P{P_EXEMPTION_REASON}.isEmpty()
?   "All"
:   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "S" )
    ?   "Surplus"
    :   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "U" )
        ?   "Utilization"
        :   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "E" )
            ?   "Economic"
            :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF8_F_PERMIT_STATUS" class="java.lang.String" resetType="None">
