	</variable>
	<variable name="CCF11_EXEMPTION_NUMBER_AND_TYPE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{FEE_SUMMARY_RPT.EXPORT_EXEMPTION_TYPE_CODE} + ' ' + {FEE_SUMMARY_RPT.EXEMPTION_NUMBER}

( $F{EXPORT_EXEMPTION_TYPE_CODE} == null || $F{EXPORT_EXEMPTION_TYPE_CODE}.isEmpty() ? "" : $F{EXPORT_EXEMPTION_TYPE_CODE} + " " )  +
( $F{EXEMPTION_NUMBER} == null || $F{EXEMPTION_NUMBER}.isEmpty() ? "" : $F{EXEMPTION_NUMBER} )]]></variableExpression>
