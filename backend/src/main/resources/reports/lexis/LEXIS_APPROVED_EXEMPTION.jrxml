<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="LEXIS_APPROVED_EXEMPTION"
              pageWidth="792"
              pageHeight="612"
              orientation="Landscape"
              whenNoDataType="NoDataSection"
              columnWidth="744"
              leftMargin="24"
              rightMargin="24"
              topMargin="24"
              bottomMargin="24">
    <parameter name="REPORT_TITLE" class="java.lang.String"/>
    <parameter name="REPORT_SUBTITLE" class="java.lang.String"/>
    <parameter name="REPORT_GENERATED_DATE" class="java.lang.String"/>

    <field name="EXEMPTION_NUMBER" class="java.lang.String"/>
    <field name="APPROVED_VOLUME" class="java.lang.String"/>
    <field name="APPROVAL_DATE" class="java.lang.String"/>
    <field name="EXPIRY_DATE" class="java.lang.String"/>
    <field name="OTHER_CONDITIONS" class="java.lang.String"/>
    <field name="ENTRY_USERID" class="java.lang.String"/>
    <field name="ENTRY_TIMESTAMP" class="java.lang.String"/>
    <field name="UPDATE_USERID" class="java.lang.String"/>
    <field name="UPDATE_TIMESTAMP" class="java.lang.String"/>
    <field name="EXPORT_EXEMPTION_TYPE_CODE" class="java.lang.String"/>
    <field name="EXPORT_EXEMPTION_STATUS_CODE" class="java.lang.String"/>
    <field name="STATUS_DESCRIPTION" class="java.lang.String"/>
    <field name="VOLUME_REMAINING" class="java.lang.String"/>
    <field name="ADVERTISING_DATE" class="java.lang.String"/>
    <field name="ORG_UNIT_NAME" class="java.lang.String"/>
    <field name="AGENT_CLIENT_NUMBER" class="java.lang.String"/>
    <field name="OWNER_CLIENT_NUMBER" class="java.lang.String"/>

    <title>
        <band height="56" splitType="Prevent">
            <textField>
                <reportElement x="0" y="0" width="560" height="22"/>
                <textElement><font fontName="Arial" size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE} == null ? "Approved Exemption Report" : $P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="28" width="744" height="18"/>
                <textElement><font fontName="Arial" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_SUBTITLE} == null ? "" : $P{REPORT_SUBTITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="560" y="0" width="184" height="18"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + ($P{REPORT_GENERATED_DATE} == null ? "" : $P{REPORT_GENERATED_DATE})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <detail>
        <band height="240" splitType="Prevent">
            <frame>
                <reportElement x="0" y="0" width="744" height="240"/>
                <box><pen lineWidth="0.8"/></box>

                <staticText><reportElement x="0" y="0" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Exemption number]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="0" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{EXEMPTION_NUMBER}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="20" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Exemption type code]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="20" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{EXPORT_EXEMPTION_TYPE_CODE}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="40" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="40" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{STATUS_DESCRIPTION}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="60" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Status code]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="60" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{EXPORT_EXEMPTION_STATUS_CODE}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="80" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Approval date]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="80" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{APPROVAL_DATE} == null || $F{APPROVAL_DATE}.length() <= 10 ? $F{APPROVAL_DATE} : $F{APPROVAL_DATE}.substring(0, 10)]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="100" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Expiry date]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="100" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{EXPIRY_DATE} == null || $F{EXPIRY_DATE}.length() <= 10 ? $F{EXPIRY_DATE} : $F{EXPIRY_DATE}.substring(0, 10)]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="120" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Approved volume (m³)]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="120" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{APPROVED_VOLUME}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="140" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Volume remaining (m³)]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="140" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{VOLUME_REMAINING}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="160" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Advertising date]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="160" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{ADVERTISING_DATE}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="180" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Region]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="180" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{ORG_UNIT_NAME}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="200" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Owner client number]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="200" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{OWNER_CLIENT_NUMBER}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="220" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Agent client number]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="220" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{AGENT_CLIENT_NUMBER}]]></textFieldExpression></textField>
            </frame>
        </band>
        <band height="40" splitType="Stretch">
            <staticText><reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="210" height="40"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Other conditions]]></text></staticText>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="210" y="0" width="534" height="40"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Top"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{OTHER_CONDITIONS}]]></textFieldExpression></textField>
        </band>
        <band height="80" splitType="Prevent">
            <frame>
                <reportElement x="0" y="0" width="744" height="80"/>
                <box><pen lineWidth="0.8"/></box>

                <staticText><reportElement x="0" y="0" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Entered by]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="0" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{ENTRY_USERID}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="20" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Entry timestamp]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="20" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{ENTRY_TIMESTAMP}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="40" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Updated by]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="40" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{UPDATE_USERID}]]></textFieldExpression></textField>

                <staticText><reportElement x="0" y="60" width="210" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9" isBold="true"/></textElement><text><![CDATA[Updated timestamp]]></text></staticText>
                <textField isBlankWhenNull="true"><reportElement x="210" y="60" width="534" height="20"/><box><pen lineWidth="0.3"/></box><textElement verticalAlignment="Middle"><font fontName="Arial" size="9"/></textElement><textFieldExpression><![CDATA[$F{UPDATE_TIMESTAMP}]]></textFieldExpression></textField>
            </frame>
        </band>
    </detail>

    <noData>
        <band height="90">
            <textField>
                <reportElement x="0" y="0" width="560" height="22"/>
                <textElement><font fontName="Arial" size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE} == null ? "Approved Exemption Report" : $P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="28" width="744" height="18"/>
                <textElement><font fontName="Arial" size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_SUBTITLE} == null ? "" : $P{REPORT_SUBTITLE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="58" width="744" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Arial" size="11" isBold="true"/></textElement>
                <text><![CDATA[No approved exemption data matched this exemption number.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
