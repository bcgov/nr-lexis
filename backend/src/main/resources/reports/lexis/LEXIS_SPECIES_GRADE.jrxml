    <title>
        <band height="56" splitType="Prevent">
            <textField>
                <reportElement x="0" y="0" width="900" height="22"/>
                <textElement><font fontName="Arial" size="16" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE} == null ? "Species and Grade Report" : $P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="950" y="0" width="226" height="18"/>
                <textElement textAlignment="Right"><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA["Generated: " + ($P{REPORT_GENERATED_DATE} == null ? "" : $P{REPORT_GENERATED_DATE})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="28" width="1176" height="20"/>
                <textElement><font fontName="Arial" size="9"/></textElement>
                <textFieldExpression><![CDATA[$P{REPORT_SUBTITLE} == null ? "" : $P{REPORT_SUBTITLE}]]></textFieldExpression>
            </textField>
        </band>
