	<variable name="CCF0_TENURE_TYPE_LIST" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_TENURE_TYPE_1}) or {?P_TENURE_TYPE_1} = '' then
//    'All'
//else
//    {?P_TENURE_TYPE_1} + ' ' + {?P_TENURE_TYPE_2} + ' ' + {?P_TENURE_TYPE_3} + ' ' +
//  {?P_TENURE_TYPE_4} + ' ' + {?P_TENURE_TYPE_5} + ' ' + {?P_TENURE_TYPE_6}

( $P{P_TENURE_TYPE_1}==null || $P{P_TENURE_TYPE_1}.isEmpty()
?   "All"
:   ( $P{P_TENURE_TYPE_1} == null || $P{P_TENURE_TYPE_1}.isEmpty() ? "" : $P{P_TENURE_TYPE_1} + " " ) +
    ( $P{P_TENURE_TYPE_2} == null || $P{P_TENURE_TYPE_2}.isEmpty() ? "" : $P{P_TENURE_TYPE_2} + " " ) +
    ( $P{P_TENURE_TYPE_3} == null || $P{P_TENURE_TYPE_3}.isEmpty() ? "" : $P{P_TENURE_TYPE_3} + " " ) +
    ( $P{P_TENURE_TYPE_4} == null || $P{P_TENURE_TYPE_4}.isEmpty() ? "" : $P{P_TENURE_TYPE_4} + " " ) +
    ( $P{P_TENURE_TYPE_5} == null || $P{P_TENURE_TYPE_5}.isEmpty() ? "" : $P{P_TENURE_TYPE_5} + " " ) +
    ( $P{P_TENURE_TYPE_6} == null || $P{P_TENURE_TYPE_6}.isEmpty() ? "" : $P{P_TENURE_TYPE_6} )
)]]></variableExpression>
	</variable>
	<variable name="CCF1_TIMBER_MARK_LIST" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_TIMBER_MARK_1}) or {?P_TIMBER_MARK_1} = '' then
//    'All'
//else
//    {?P_TIMBER_MARK_1} + " " + {?P_TIMBER_MARK_2} + " " + {?P_TIMBER_MARK_3} + " " +
//  {?P_TIMBER_MARK_4} + " " + {?P_TIMBER_MARK_5} + " " + {?P_TIMBER_MARK_6}

$P{P_TIMBER_MARK_1} == null || $P{P_TIMBER_MARK_1}.isEmpty()
?   "All"
:   ( $P{P_TIMBER_MARK_1} == null || $P{P_TIMBER_MARK_1}.isEmpty() ? "" : $P{P_TIMBER_MARK_1} + " " ) +
    ( $P{P_TIMBER_MARK_2} == null || $P{P_TIMBER_MARK_2}.isEmpty() ? "" : $P{P_TIMBER_MARK_2} + " " ) +
    ( $P{P_TIMBER_MARK_3} == null || $P{P_TIMBER_MARK_3}.isEmpty() ? "" : $P{P_TIMBER_MARK_3} + " " ) +
    ( $P{P_TIMBER_MARK_4} == null || $P{P_TIMBER_MARK_4}.isEmpty() ? "" : $P{P_TIMBER_MARK_4} + " " ) +
    ( $P{P_TIMBER_MARK_5} == null || $P{P_TIMBER_MARK_5}.isEmpty() ? "" : $P{P_TIMBER_MARK_5} + " " ) +
    ( $P{P_TIMBER_MARK_6} == null || $P{P_TIMBER_MARK_6}.isEmpty() ? "" : $P{P_TIMBER_MARK_6} )]]></variableExpression>
	</variable>
	<variable name="CCF2_F_FOREST_FILE_ID" class="java.lang.String" resetType="None">
