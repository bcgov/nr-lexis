?   "All"
:   $P{P_EXEMPTION_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF4_F_REGION" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//GetRegionName({?P_ORG_UNIT_NUMBER})
//Function (StringVar P_ORG_UNIT)
//Local StringVar org_unit_name := "";
//Local NumberVar counter := 0;
//if (P_ORG_UNIT LIKE "*1903*") then ( org_unit_name := org_unit_name & ", RCB";
//    counter := counter + 1; );
//if (P_ORG_UNIT LIKE "*1904*") then(     org_unit_name := org_unit_name & ", RKB";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1905*") then(    org_unit_name := org_unit_name & ", RNO";
//    counter := counter + 1; );
//if (P_ORG_UNIT LIKE "*1906*") then(    org_unit_name := org_unit_name & ", ROM";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1907*") then(    org_unit_name := org_unit_name & ", RTO";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1908*") then(    org_unit_name := org_unit_name & ", RSK";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1909*") then(    org_unit_name := org_unit_name & ", RSC";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1910*") then(    org_unit_name := org_unit_name & ", RWC";
//    counter := counter + 1;);
//if Len(org_unit_name) > 0 then
//(  if counter = 8 then
//        "All"
//  else
//      Right(org_unit_name, len(org_unit_name) - 2)
//)else
//    org_unit_name;

$P{P_ORG_UNIT_NUMBER} == null ? "" :
$P{P_ORG_UNIT_NUMBER}!=null &&
$P{P_ORG_UNIT_NUMBER}.contains( "1903" )&& $P{P_ORG_UNIT_NUMBER}.contains( "1904" ) && $P{P_ORG_UNIT_NUMBER}.contains( "1905" ) && $P{P_ORG_UNIT_NUMBER}.contains( "1906" ) &&
$P{P_ORG_UNIT_NUMBER}.contains( "1907" )&& $P{P_ORG_UNIT_NUMBER}.contains( "1908" ) && $P{P_ORG_UNIT_NUMBER}.contains( "1909" ) && $P{P_ORG_UNIT_NUMBER}.contains( "1910" )
?   "All"
:   org.apache.commons.lang.StringUtils.chomp(
    (
        ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1903" ) ? "RCB, " : "" ) +
        ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1904" ) ? "RKB, " : "" ) +
        ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1905" ) ? "RNO, " : "" ) +
        ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1906" ) ? "ROM, " : "" ) +
        ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1907" ) ? "RTO, " : "" ) +
        ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1908" ) ? "RSK, " : "" ) +
        ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1909" ) ? "RSC, " : "" ) +
        ($P{P_ORG_UNIT_NUMBER}!=null && $P{P_ORG_UNIT_NUMBER}.contains( "1910" ) ? "RWC, " : "" )
     ), ", ")]]></variableExpression>
	</variable>
	<variable name="CCF5_F_EXE_REASON" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (isnull({?P_EXEMPTION_REASON})) then
//'All'
//else if ({?P_EXEMPTION_REASON} = 'S') then
//'Surplus'
//else if ({?P_EXEMPTION_REASON} = 'E') then
//'Economic'
//else if ({?P_EXEMPTION_REASON} = 'U') then
//Utilization'
//else
//'All'

$P{P_EXEMPTION_REASON} == null || $P{P_EXEMPTION_REASON}.isEmpty()
?   "All"
:   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "S" )
    ?   "Surplus"
    :   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "E" )
        ?   "Economic"
        :   $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "U" )
            ?   "Utilization"
            :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF6_F_EXE_TYPE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?P_EXEMPTION_TYPE} = 'M') then
//'Ministerial'
//else if ({?P_EXEMPTION_TYPE} = 'F') then
//'Federal'
//else if ({?P_EXEMPTION_TYPE} = 'O') then
//'Order In Council'
//else
//'All'

$P{P_EXEMPTION_TYPE} == null || $P{P_EXEMPTION_TYPE}.isEmpty()
?   "All"
:   $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "M" )
    ?   "Ministerial"
    :   $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "F" )
        ?   "Federal"
        :   $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "O" )
            ?   "Order In Council"
            :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF7_F_CLIENT_TYPE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_CLIENT_TYPE}) or {?P_CLIENT_TYPE} = '' then
//    'All'
//else if {?P_CLIENT_TYPE} = 'P' then
//    'Permit Holder'
//else if {?P_CLIENT_TYPE} = 'M' then
//    'Mark Holder'

$P{P_CLIENT_TYPE} == null || $P{P_CLIENT_TYPE}.isEmpty()
?   "All"
:   $P{P_CLIENT_TYPE}.equalsIgnoreCase( "P" )
    ?   "Permit Holder"
    :   $P{P_CLIENT_TYPE}.equalsIgnoreCase( "M" )
        ?   "Mark Holder"
        :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF8_F_CLIENT_NUMBER" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_CLIENT_NUMBER}) or {?P_CLIENT_NUMBER} = '' then
//    'All'
//else
//    {?P_CLIENT_NUMBER}

$P{P_CLIENT_NUMBER} == null || $P{P_CLIENT_NUMBER}.isEmpty()
?   "All"
:   $P{P_CLIENT_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF9_F_DATE_FROM" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_FROM_DATE}) or {?P_FROM_DATE} = '' then
//    'Not Entered'
//else
//    {?P_FROM_DATE}

$P{P_FROM_DATE} == null || $P{P_FROM_DATE}.isEmpty()
?   "Not Entered"
:   $P{P_FROM_DATE}]]></variableExpression>
	</variable>
	<variable name="CCF10_F_DATE_TO" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_TO_DATE}) or {?P_TO_DATE} = '' then
//    'Not Entered'
//else
//    {?P_TO_DATE}

$P{P_TO_DATE} == null || $P{P_TO_DATE}.isEmpty()
?   "Not Entered"
:   $P{P_TO_DATE}]]></variableExpression>
	</variable>
	<variable name="CCF11_TITLE_DATE_RANGE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if (
//    (isnull({?P_FROM_DATE}) or {?P_FROM_DATE} = '') and
//    (isnull({?P_TO_DATE}) or {?P_TO_DATE} = '')
//    ) then
//'All Dates'
//else if (
//    isnull({?P_FROM_DATE}) or {?P_FROM_DATE} = ''
//    ) then
//{?P_TO_DATE} + ' and Previous'
//else if (
//    isnull({?P_TO_DATE}) or {?P_TO_DATE} = ''
//    ) then
//{?P_FROM_DATE} + ' and After'
//else
//
//{?P_FROM_DATE} + ' to ' + {?P_TO_DATE}

($P{P_FROM_DATE} == null || $P{P_FROM_DATE}.isEmpty() ) &&
($P{P_TO_DATE} == null || $P{P_TO_DATE}.isEmpty() )
?   "All Dates"
:   $P{P_FROM_DATE} == null || $P{P_FROM_DATE}.isEmpty()
    ?   $P{P_TO_DATE} + " and Previous"
    :   $P{P_TO_DATE} == null || $P{P_TO_DATE}.isEmpty()
        ?   $P{P_FROM_DATE} + " and After"
        :   $P{P_FROM_DATE} + " to " + $P{P_TO_DATE}]]></variableExpression>
	</variable>
