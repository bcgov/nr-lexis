$P{P_FOREST_FILE_ID} == null || $P{P_FOREST_FILE_ID}.isEmpty()
?   "All"
:   $P{P_FOREST_FILE_ID}]]></variableExpression>
	</variable>
	<variable name="CCF3_F_EXE_NUMBER" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_EXEMPTION_NUMBER}) or {?P_EXEMPTION_NUMBER} = '' then
//    'All'
