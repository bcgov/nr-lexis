	<variable name="CCF5_CLIENT_RPT_ADDRESS" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{@CLIENT_NAME} &
//{@CLIENT_ADDRESS_1} &
//@CLIENT_ADDRESS_2} &
//{@CLIENT_ADDRESS_3} &
//{@CLIENT_CITY} & ", " & {@CLIENT_PROVINCE} &
//{@CLIENT_POSTAL_CODE} &
//Chr(13) &
//{@CLIENT_CONTACT_NAME} &
//{@CLIENT_HOME_PHONE} &
//{@CLIENT_PHONE} &
//{@CLIENT_FAX} &
//{@CLIENT_EMAIL}

$V{CCF4_CLIENT_NAME} +
$V{CCF6_CLIENT_ADDRESS_1} +
$V{CCF7_CLIENT_ADDRESS_2} +
$V{CCF8_CLIENT_ADDRESS_3} +
$V{CCF9_CLIENT_CITY} + ", " + $V{CCF10_CLIENT_PROVINCE} +
$V{CCF11_CLIENT_POSTAL_CODE} +
System.getProperty("line.separator") +
$V{CCF17_CLIENT_CONTACT_NAME}+
$V{CCF16_CLIENT_HOME_PHONE} +
$V{CCF13_CLIENT_PHONE} +
$V{CCF14_CLIENT_FAX} +
$V{CCF15_CLIENT_EMAIL}]]></variableExpression>
	</variable>
	<variable name="CCF18_JURIS_CODE_SUMMARY" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ISNULL ({?P_JURISDICTION}) THEN
//"All"
//ELSE
//IF ({?P_JURISDICTION} = "P") THEN
//"Provincial"
//ELSE
//IF ({?P_JURISDICTION} = "F") THEN
//"Federal"
//ELSE
//"All"

$P{P_JURISDICTION} == null || $P{P_JURISDICTION}.isEmpty()
?   "All"
:   $P{P_JURISDICTION}.equalsIgnoreCase( "P" )
    ?   "Provincial"
    :   $P{P_JURISDICTION}.equalsIgnoreCase( "F" )
        ?   "Federal"
        :   "All"]]></variableExpression>
	</variable>
