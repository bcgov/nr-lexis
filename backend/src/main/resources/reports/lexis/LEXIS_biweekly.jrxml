//"Bus. Phone: " & {BIWEEKLY_RPT.AGENT_BUS_PHONE} & chr(13)

$F{AGENT_BUS_PHONE} == null || $F{AGENT_BUS_PHONE}.isEmpty() || ($F{AGENT_BUS_PHONE}.trim()).isEmpty()
?   ""
:   "Bus. Phone: " + $F{AGENT_BUS_PHONE} + System.getProperty("line.separator")]]></variableExpression>
	</variable>
	<variable name="CCF29_AGENT_FAX" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ISNULL ({BIWEEKLY_RPT.AGENT_FAX}) THEN
//''
//ELSE
//IF (Trim({BIWEEKLY_RPT.AGENT_FAX}) = '') THEN
//''
//ELSE
//"Fax: " & {BIWEEKLY_RPT.AGENT_FAX} & chr(13)

$F{AGENT_FAX} == null || $F{AGENT_FAX}.isEmpty() || ($F{AGENT_FAX}.trim()).isEmpty()
?   ""
:   "Fax: " + $F{AGENT_FAX} + System.getProperty("line.separator")]]></variableExpression>
	</variable>
	<variable name="CCF31_AGENT_EMAIL" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//IF ISNULL ({BIWEEKLY_RPT.AGENT_EMAIL}) THEN
//''
//ELSE
//IF (Trim({BIWEEKLY_RPT.AGENT_EMAIL}) = '') THEN
//''
//ELSE
//"Email: " & {BIWEEKLY_RPT.AGENT_EMAIL} & chr(13)

$F{AGENT_EMAIL} == null || $F{AGENT_EMAIL}.isEmpty() || ($F{AGENT_EMAIL}.trim()).isEmpty()
?   ""
:   "Email: " + $F{AGENT_EMAIL} + System.getProperty("line.separator")]]></variableExpression>
	</variable>
	<variable name="CCF30_AGENT_RPT_ADDRESS" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//{@AGENT_CLIENT_NAME} &
//{@AGENT_ADDRESS_1} &
//{@AGENT_ADDRESS_2} &
//{@AGENT_ADDRESS_3} &
//{@AGENT_CITY} & ", " & {@AGENT_PROVINCE} &
//{@AGENT_POSTAL} &
//Chr(13) &
//@AGENT_CONTACT_NAME} &
//{@AGENT_HOME_PHONE} &
//{@AGENT_BUS_PHONE} &
//{@AGENT_FAX} &
//{@AGENT_EMAIL}

$V{CCF20_AGENT_CLIENT_NAME} +
$V{CCF21_AGENT_ADDRESS_1} +
$V{CCF22_AGENT_ADDRESS_2} +
$V{CCF23_AGENT_ADDRESS_3} +
$V{CCF24_AGENT_CITY} + ", " + $V{CCF25_AGENT_PROVINCE} +
$V{CCF26_AGENT_POSTAL} +
System.getProperty("line.separator") +
$V{CCF19_AGENT_CONTACT_NAME} +
$V{CCF27_AGENT_HOME_PHONE} +
$V{CCF28_AGENT_BUS_PHONE} +
$V{CCF29_AGENT_FAX} +
$V{CCF31_AGENT_EMAIL}]]></variableExpression>
	</variable>
	<variable name="CCF32_F_APPLICATION_NUMBER" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({BIWEEKLY_RPT.EXPORT_JURISDICTION_CODE} = "F") Then
//    {BIWEEKLY_RPT.EXPORT_JURISDICTION_CODE} + ToText({BIWEEKLY_RPT.FED_APPLICATION_NUMBER}, 0, "")
//else if ({BIWEEKLY_RPT.EXPORT_JURISDICTION_CODE} = "P") Then
//    {BIWEEKLY_RPT.EXPORT_JURISDICTION_CODE} + ToText({BIWEEKLY_RPT.APPLICATION_NUMBER}, 0, "")
//else
//""

$F{EXPORT_JURISDICTION_CODE} == null || $F{EXPORT_JURISDICTION_CODE}.isEmpty()
?   ""
:   $F{EXPORT_JURISDICTION_CODE}.equalsIgnoreCase( "F" )
    ?   $F{EXPORT_JURISDICTION_CODE} + ( $F{FED_APPLICATION_NUMBER} == null ? "" : new DecimalFormat("###0").format( $F{FED_APPLICATION_NUMBER} ) )
    :   $F{EXPORT_JURISDICTION_CODE}.equalsIgnoreCase( "P" )
        ?   $F{EXPORT_JURISDICTION_CODE} + ( $F{APPLICATION_NUMBER} == null ? "" : new DecimalFormat("###0").format( $F{APPLICATION_NUMBER} ) )
        :   ""]]></variableExpression>
	</variable>
