	<variable name="CCF0_SUMMARY_REGION" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//GetRegionName({?P_ORG_UNIT})
//Function (StringVar P_ORG_UNIT)
//Local StringVar org_unit_name := "";
//Local NumberVar counter := 0;
//if (P_ORG_UNIT LIKE "*1903*") then ( org_unit_name := org_unit_name & ", RCB";
//    counter := counter + 1; );
//if (P_ORG_UNIT LIKE "*1904*") then(     org_unit_name := org_unit_name & ", RKB";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1905*") then(    org_unit_name := org_unit_name & ", RNO";
//    counter := counter + 1; );
//if (P_ORG_UNIT LIKE "*1906*") then(    org_unit_name := org_unit_name & ", ROM";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1907*") then(    org_unit_name := org_unit_name & ", RTO";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1908*") then(    org_unit_name := org_unit_name & ", RSK";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1909*") then(    org_unit_name := org_unit_name & ", RSC";
//    counter := counter + 1;);
//if (P_ORG_UNIT LIKE "*1910*") then(    org_unit_name := org_unit_name & ", RWC";
//    counter := counter + 1;);
//if Len(org_unit_name) > 0 then
//(  if counter = 8 then
//        "All"
//  else
//      Right(org_unit_name, len(org_unit_name) - 2)
//)else
//    org_unit_name;

$P{P_ORG_UNIT}!=null &&
$P{P_ORG_UNIT}.contains( "1903" )&& $P{P_ORG_UNIT}.contains( "1904" ) && $P{P_ORG_UNIT}.contains( "1905" ) && $P{P_ORG_UNIT}.contains( "1906" ) &&
$P{P_ORG_UNIT}.contains( "1907" )&& $P{P_ORG_UNIT}.contains( "1908" ) && $P{P_ORG_UNIT}.contains( "1909" ) && $P{P_ORG_UNIT}.contains( "1910" )
?   "All"
:   ca.bc.gov.mof.lexis.service.report.LexisReportStringUtils.chop(
       (($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1903" ) ? "RCB, " : "" ) +
       ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1904" ) ? "RKB, " : "" ) +
       ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1905" ) ? "RNO, " : "" ) +
       ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1906" ) ? "ROM, " : "" ) +
       ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1907" ) ? "RTO, " : "" ) +
       ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1908" ) ? "RSK, " : "" ) +
       ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1909" ) ? "RSC, " : "" ) +
       ($P{P_ORG_UNIT}!=null && $P{P_ORG_UNIT}.contains( "1910" ) ? "RWC, " : "" )).trim()
   )]]></variableExpression>
	</variable>
	<variable name="CCF1_SUMMARY_REASON" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?P_EXEMPTION_REASON} = 'S') then
//'Surplus'
//else if ({?P_EXEMPTION_REASON} = 'U') then
//'Utilization'
//else if ({?P_EXEMPTION_REASON} = 'E') then
//'Economic'
//else
//'All'

$P{P_EXEMPTION_REASON}!=null && $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "S" )
?   "Surplus"
:   $P{P_EXEMPTION_REASON}!=null && $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "U" )
    ?   "Utilization"
    :   $P{P_EXEMPTION_REASON}!=null && $P{P_EXEMPTION_REASON}.equalsIgnoreCase( "E" )
        ?   "Economic"
        :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF2_SUMMARY_TYPE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?P_EXEMPTION_TYPE} = 'M') then
//'Ministerial'
//else if ({?P_EXEMPTION_TYPE} = 'F') then
//'Federal'
//else if ({?P_EXEMPTION_TYPE} = 'O') then
//'Order In Council'
//else
//'All'

$P{P_EXEMPTION_TYPE}!=null && $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "M" )
?   "Ministerial"
:   $P{P_EXEMPTION_TYPE}!=null && $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "F" )
    ?   "Federal"
    :   $P{P_EXEMPTION_TYPE}!=null && $P{P_EXEMPTION_TYPE}.equalsIgnoreCase( "O" )
        ?   "Order In Council"
        :   "All"]]></variableExpression>
	</variable>
	<variable name="CCF3_TITLE_DATE_RANGE" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ((isnull({?P_FROM_DATE}) or {?P_FROM_DATE} = '')and(isnull({?P_TO_DATE}) or {?P_TO_DATE} = '')
//    ) then
//'All Dates'
//else if (
//    isnull({?P_FROM_DATE}) or {?P_FROM_DATE} = ''
//    ) then
//{?P_TO_DATE} + ' and Previous'
//else if (
//    isnull({?P_TO_DATE}) or {?P_TO_DATE} = ''
//    ) then
//{?P_FROM_DATE} + ' and After'
//else
//{?P_FROM_DATE} + ' to ' + {?P_TO_DATE}

($P{P_FROM_DATE}==null || $P{P_FROM_DATE}.isEmpty()) &&
($P{P_TO_DATE}==null || $P{P_TO_DATE}.isEmpty())
?   "All Dates"
:   $P{P_FROM_DATE}==null || $P{P_FROM_DATE}.isEmpty()
    ?   $P{P_TO_DATE} + "  and Previous"
    :   $P{P_TO_DATE}==null || $P{P_TO_DATE}.isEmpty()
        ?   $P{P_FROM_DATE} + " and After"
        :   $P{P_FROM_DATE} + " to " + $P{P_TO_DATE}]]></variableExpression>
	</variable>
	<variable name="CCF4_F_CLIENT" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_CLIENT}) or {?P_CLIENT} = '' then
//    'All'
//else
//    {?P_CLIENT}

$P{P_CLIENT} == null ||$P{P_CLIENT}.isEmpty()
?   "All"
:   $P{P_CLIENT}]]></variableExpression>
	</variable>
	<variable name="CCF5_F_DATE_FROM" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_LISTING_FROM_DATE}) or {?P_LISTING_FROM_DATE} = '' then
//    'Not Entered'
//else
//    {?P_LISTING_FROM_DATE}

$P{P_LISTING_FROM_DATE}==null || $P{P_LISTING_FROM_DATE}.isEmpty()
?   "Not Entered"
:   $P{P_LISTING_FROM_DATE}]]></variableExpression>
	</variable>
	<variable name="CCF6_F_DATE_TO" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_LISTING_TO_DATE}) or {?P_LISTING_TO_DATE} = '' then
//    'Not Entered'
//else
//    {?P_LISTING_TO_DATE}

$P{P_LISTING_TO_DATE}==null || $P{P_LISTING_TO_DATE}.isEmpty()
?   "Not Entered"
:   $P{P_LISTING_TO_DATE}]]></variableExpression>
	</variable>
	<variable name="CCF7_F_APPLICATION_NUMBER" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({EXEMPTION_LEDGER_RPT.EXPORT_JURISDICTION_CODE} = "F") Then
//    ToText({EXEMPTION_LEDGER_RPT.FED_APPLICATION_NUMBER}, 0, "")
//else if ({EXEMPTION_LEDGER_RPT.EXPORT_JURISDICTION_CODE} = "P") Then
//    ToText({EXEMPTION_LEDGER_RPT.APPLICATION_NUMBER}, 0, "")
//else
//""

$F{EXPORT_JURISDICTION_CODE}!=null && $F{EXPORT_JURISDICTION_CODE}.equalsIgnoreCase( "F" )
?   ( $F{FED_APPLICATION_NUMBER} == null ? "" : $F{FED_APPLICATION_NUMBER}.toString() )
:   $F{EXPORT_JURISDICTION_CODE}!=null && $F{EXPORT_JURISDICTION_CODE}.equalsIgnoreCase( "P" )
    ?   ( $F{APPLICATION_NUMBER} == null ? "" : $F{APPLICATION_NUMBER}.toString() )
    :   ""]]></variableExpression>
	</variable>
	<variable name="CCF8_F_EXEMPTION_NUMBER" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if isnull({?P_EXEMPTION_NUMBER}) or {?P_EXEMPTION_NUMBER} = '' then
//    'All'
//else
//    {?P_EXEMPTION_NUMBER}

$P{P_EXEMPTION_NUMBER}==null || $P{P_EXEMPTION_NUMBER}.isEmpty()
?   "All"
:   $P{P_EXEMPTION_NUMBER}]]></variableExpression>
	</variable>
	<variable name="CCF9_SUMMARY_STATUS" class="java.lang.String" resetType="None">
		<variableExpression><![CDATA[//if ({?P_EXEMPTION_STATUS} = 'NEW') then
//'New'
//else if ({?P_EXEMPTION_STATUS} = 'ACT') then
//'Active'
//else if ({?P_EXEMPTION_STATUS} = 'CAN') then
//'Cancelled'
//else if ({?P_EXEMPTION_STATUS} = 'EXP') then
//'Expired'
//else
//'All'

$P{P_EXEMPTION_STATUS}!=null && $P{P_EXEMPTION_STATUS}.equalsIgnoreCase( "NEW" )
?   "New"
:   $P{P_EXEMPTION_STATUS}!=null && $P{P_EXEMPTION_STATUS}.equalsIgnoreCase( "ACT" )
    ?   "Active"
    :   $P{P_EXEMPTION_STATUS}!=null && $P{P_EXEMPTION_STATUS}.equalsIgnoreCase( "CAN" )
        ?   "Cancelled"
        :   $P{P_EXEMPTION_STATUS}!=null && $P{P_EXEMPTION_STATUS}.equalsIgnoreCase( "EXP" )
            ?   "Expired"
            :   "All"]]></variableExpression>
	</variable>
