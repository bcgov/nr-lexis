			<xs:element name="timberMark" type="mof:AlphaNumeric6" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="StandingTimberType">
		<xs:sequence>
			<xs:element name="timberMark" type="mof:AlphaNumeric6" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
