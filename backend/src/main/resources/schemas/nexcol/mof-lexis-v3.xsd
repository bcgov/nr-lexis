			<xs:element name="timberMark" type="mof:AlphaNumeric6" minOccurs="1" maxOccurs="1"/>
			<xs:element name="numberOfPieces" type="mof:NonNegativeInteger10D" minOccurs="1" maxOccurs="1"/>
			<xs:element name="species" type="SpeciesCodeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="grade" type="GradeCodeType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="quantityVolume" type="mof:Decimal7D1d" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="HarvestedTimberWithoutSummaryOfScaleType">
