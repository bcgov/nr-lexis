			<xs:element name="provinceState" type="mof:AlphaNumeric50" minOccurs="0" maxOccurs="1"/>
			<xs:element name="postalZipCode" type="mof:AlphaNumeric20" minOccurs="0" maxOccurs="1"/>
			<xs:element name="country" type="mof:AlphaNumeric50" minOccurs="0" maxOccurs="1"/>
