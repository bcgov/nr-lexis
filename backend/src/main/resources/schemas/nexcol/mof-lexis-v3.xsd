				<xs:element name="harvestedTimber" type="HarvestedTimberType" maxOccurs="unbounded" minOccurs="1"/>
				<xs:element name="harvestedTimberWithoutSummaryOfScale" type="HarvestedTimberWithoutSummaryOfScaleType" maxOccurs="unbounded" minOccurs="1"/>
				<xs:element name="standingTimber" type="StandingTimberType" maxOccurs="unbounded" minOccurs="1"/>
