			<xs:element name="faxNumber" type="mof:TelephoneNumberType" minOccurs="0" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="OwnerType">
		<xs:sequence>
			<xs:element name="ownerDetails" type="LegalEntityType"/>
			<xs:element name="ownerContact" type="ContactType"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ApplicantType">
		<xs:sequence>
			<xs:element name="applicantDetails" type="LegalEntityType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="applicantContact" type="ContactType" minOccurs="1" maxOccurs="1"/>
			<xs:element name="declarationCanadianResident" type="xs:boolean" minOccurs="1" maxOccurs="1"/>
			<xs:element name="declarationSubmittedOffersPast90Days" type="xs:boolean" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ContactType">
		<xs:sequence>
			<xs:element name="contactSurname" type="mof:AlphaNumeric50" minOccurs="1" maxOccurs="1"/>
