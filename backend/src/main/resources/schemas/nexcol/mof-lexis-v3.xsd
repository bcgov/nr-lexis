<xs:schema xmlns:mof="http://www.for.gov.bc.ca/schema/simpleTypes" xmlns="http://www.for.gov.bc.ca/schema/lexis" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.for.gov.bc.ca/schema/lexis" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1">
	<xs:import namespace="http://www.for.gov.bc.ca/schema/simpleTypes" schemaLocation="mof-simpleTypes.xsd"/>
	<xs:complexType name="LexisSubmissionType">
		<xs:sequence>
			<xs:element name="applicant" type="ApplicantType" minOccurs="1" maxOccurs="1"/>
