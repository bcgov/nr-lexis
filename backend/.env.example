# ===========================================
# LEXIS Backend Environment Variables
# ===========================================
# Copy to .env for local usage when needed.
# Prefer shell env vars for secrets in shared environments.

# Server
SERVER_PORT=8080

# Spring
SPRING_PROFILES_ACTIVE=oracle,local

# Oracle
DATABASE_HOST=
DATABASE_PORT=1543
DATABASE_SERVICE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
KEYSTORE_SECRET=
TRUSTSTORE_PATH=/cert/jssecacerts

# Cognito (optional while local auth is disabled)
AWS_COGNITO_ISSUER_URI=
AWS_COGNITO_JWK_SET_URI=
LEXIS_COGNITO_ENABLED=false
LEXIS_ENFORCE_ROUTE_AUTH=false

# Optional Jasper settings (fill when report integration is enabled)
J_URL_FETCH=
J_USERNAME=
J_PASSWORD=
J_CONNECT_TIMEOUT=10s
J_READ_TIMEOUT=60s

# App config
ALLOWED_ORIGINS=http://localhost:3000
APP_LOG_LEVEL=INFO
SPRING_JPA_SHOW_SQL=false
