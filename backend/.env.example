# ===========================================
# LEXIS Backend Environment Variables
# ===========================================
# Copy to .env for local usage when needed.
# Prefer shell env vars for secrets in shared environments.

# Server
SERVER_PORT=8080

# Spring
SPRING_PROFILES_ACTIVE=oracle

# Oracle
DATABASE_HOST=
DATABASE_PORT=1543
DATABASE_SERVICE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
KEYSTORE_SECRET=
TRUSTSTORE_PATH=/cert/jssecacerts

# Cognito
AWS_COGNITO_ISSUER_URI=
AWS_COGNITO_JWK_SET_URI=
COGNITO_USERINFO_URI=
IDENTITY_LOOKUP_BASE_URL=

# Keycloak service-client issuer for NEXCOL machine-to-machine federal submissions
KEYCLOAK_ISSUER_URI=
KEYCLOAK_JWK_SET_URI=

# App config
ALLOWED_ORIGINS=http://localhost:3000
LEXIS_PROD_RTM_ONLY=false
LEXIS_EXPIRY_ENABLED=false
LEXIS_EXPIRY_CRON="30 0 0 * * *"
LEXIS_EXPIRY_ZONE=America/Vancouver
LEXIS_EXPIRY_LOCK_AT_MOST_FOR=PT6H
LEXIS_EXPIRY_LOCK_AT_LEAST_FOR=PT5M
LEXIS_REPORT_QUERY_TIMEOUT_SECONDS=120
LEXIS_PERMIT_INVOICE_MODE=legacy-best-effort
LEXIS_PERMIT_INVOICE_GBMS_TIMEOUT_SECONDS=60
LEXIS_MAIL_ENABLED=false
LEXIS_MAIL_NON_PRODUCTION=true
LEXIS_MAIL_FROM=Provincial.Log.Export.Analyst@gov.bc.ca
LEXIS_MAIL_OVERRIDE_RECIPIENTS=
# Externally managed regional distribution lists
LEXIS_MAIL_REGION_RCO_RECIPIENTS=
LEXIS_MAIL_REGION_RNI_RECIPIENTS=
LEXIS_MAIL_REGION_RSI_RECIPIENTS=
# Temporary migration fallback for unmapped/missing regional configuration
LEXIS_MAIL_PERMIT_REQUEST_RECIPIENTS=
APP_LOG_LEVEL=INFO
SPRING_SECURITY_LOG_LEVEL=INFO
SPRING_WEB_LOG_LEVEL=INFO
SPRING_BOOT_AUTOCONFIG_LOG_LEVEL=INFO
SPRING_JPA_SHOW_SQL=false
