# Optional: external login endpoint
VITE_LOGIN_URL=

# Reports: base endpoint and legacy action mapping payload control
VITE_LEXIS_REPORT_API_BASE=/lexis/reports
VITE_LEXIS_REPORT_INCLUDE_ACTION_MAPPING=true

# Create-submit: payload mode and per-module endpoint overrides
# Valid request modes: form | json
VITE_LEXIS_CREATE_SUBMIT_REQUEST_MODE=form
VITE_LEXIS_CREATE_SUBMIT_INCLUDE_ACTION_MAPPING=true
VITE_LEXIS_CREATE_APPLICATION_ENDPOINT=/lexis/applicationDetailsRPC
VITE_LEXIS_CREATE_EXEMPTION_ENDPOINT=/lexis/exemptionDetailsRPC
VITE_LEXIS_CREATE_OFFER_ENDPOINT=/lexis/offerDetailsRPC
VITE_LEXIS_CREATE_PERMIT_ENDPOINT=/lexis/rpc/permit-details/add-permit
VITE_LEXIS_CREATE_INDIGENOUS_PERMIT_ENDPOINT=/lexis/indianReservePermitDetails

# Auth cutover toggles
# Enable only when you need old session path routing behavior.
VITE_LEXIS_ENABLE_LEGACY_PATH_ROUTING=false
# Default is strict backend claims (false). Set true only for temporary compatibility fallback.
VITE_LEXIS_ENABLE_ROLE_ACTION_FALLBACK=false

# Admin policy local fallback (disabled by default for production parity).
VITE_LEXIS_ENABLE_ADMIN_POLICY_LOCAL_FALLBACK=false
