# BC Gov SSO / nr-fam browser authentication. No browser client secret.
# Register http://localhost:3000/authCallback and logout http://localhost:3000
VITE_OIDC_ISSUER_URI=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_IDIR_HINT=azureidir
VITE_OIDC_BCEID_HINT=bceidbusiness
# Optional: SiteMinder logoff chained before Keycloak end-session (Business BCeID)
VITE_OIDC_SITEMINDER_LOGOUT_URL=https://logontest7.gov.bc.ca/clp-cgi/logoff.cgi
VITE_LEXIS_PROD_RTM_ONLY=false

# Reports: base endpoint
VITE_LEXIS_REPORT_API_BASE=/lexis/reports

# Create-submit: payload mode and per-module endpoint overrides
# Valid request modes: form | json
VITE_LEXIS_CREATE_SUBMIT_REQUEST_MODE=form
VITE_LEXIS_CREATE_SUBMIT_INCLUDE_ACTION_MAPPING=true
VITE_LEXIS_CREATE_APPLICATION_ENDPOINT=/lexis/applicationDetailsRPC
VITE_LEXIS_CREATE_EXEMPTION_ENDPOINT=/lexis/exemptionDetailsRPC
VITE_LEXIS_CREATE_OFFER_ENDPOINT=/lexis/offerDetailsRPC

# Local dev server/proxy options (used by Vite).
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_DEV_BACKEND_TARGET=http://localhost:8080
VITE_HMR_HOST=localhost
VITE_HMR_PORT=3000
VITE_HMR_PROTOCOL=ws
